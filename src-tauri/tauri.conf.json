{
  "$schema": "../node_modules/@tauri-apps/cli/config.schema.json",
  "productName": "ClickSync",
  "version": "0.1.0",
  "identifier": "com.clicksync.desktop",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "ClickSync",
        "width": 1280,
        "height": 850,
        "minWidth": 1024,
        "minHeight": 700,
        "resizable": true,
        "fullscreen": false,
        "center": true
      }
    ],
    "security": {
      "csp": "default-src 'self'; img-src 'self' data: https: asset:; style-src 'self' 'unsafe-inline'; font-src 'self' data:;"
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "publisher": "ClickSync",
    "copyright": "© 2026 ClickSync",
    "category": "Productivity",
    "shortDescription": "YouTube投稿効率化コックピット",
    "longDescription": "動画の音声ファイル・字幕ファイル・台本から、サムネイル用の画像生成プロンプト（3パターン）とSEOタイトル・概要欄・ハッシュタグ・チャプターを一括生成するデスクトップアプリ",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "windows": {
      "webviewInstallMode": {
        "type": "embedBootstrapper"
      },
      "nsis": {
        "installMode": "currentUser",
        "languages": ["Japanese", "English"],
        "displayLanguageSelector": false,
        "installerIcon": "icons/icon.ico",
        "startMenuFolder": "ClickSync"
      },
      "wix": {
        "language": "ja-JP"
      }
    },
    "macOS": {
      "minimumSystemVersion": "10.15",
      "entitlements": "entitlements.plist",
      "signingIdentity": "-",
      "dmg": {
        "windowSize": { "width": 660, "height": 400 },
        "appPosition": { "x": 180, "y": 190 },
        "applicationFolderPosition": { "x": 480, "y": 190 }
      }
    },
    "linux": {
      "appimage": {
        "bundleMediaFramework": false
      },
      "deb": {
        "section": "utils"
      }
    }
  },
  "plugins": {}
}
